.DS_Store
.worktrees/
.superpowers/

# Docker Compose variable substitution env file
.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env*
!frontend/.env.example
frontend/tailwind.config.js
frontend/tailwind.config.d.ts
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/*.tsbuildinfo

# Extracted source dumps (generated, not tracked)
backend_code_extract.txt

# Backend
backend/.venv/
backend/__pycache__/
backend/uploads/originals/
backend/uploads/processed/
backend/uploads/masks/*
!backend/uploads/masks/.gitkeep
backend/uploads/jobs/*
!backend/uploads/jobs/.gitkeep
backend/uploads/batches/
backend/.env*
!backend/.env.example
**/__pycache__/
*.py[cod]

# ML models (large binary — download separately or use Git LFS)
backend/src/app/assets/ml_models/*.caffemodel

