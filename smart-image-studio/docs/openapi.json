{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Image Studio API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "ヘルスチェック",
        "description": "サービスが正常に稼働しているかを確認します。",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "\"ok\" を含むレスポンス",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/process": {
      "post": {
        "tags": [
          "images"
        ],
        "summary": "画像処理",
        "description": "アップロードされた画像に指定のパイプラインを適用し、加工結果を同期で返します。\n\n`operations` は `ImageOperationStep` の JSON 配列（文字列）です。",
        "operationId": "process_image_api_images_process_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_image_api_images_process_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "加工後の画像URL・適用した処理一覧・解析結果を含むレスポンス",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessImageResponse"
                }
              }
            }
          },
          "400": {
            "description": "ファイル名が不正、ファイルが空、画像として認識できない、または operations のバリデーションエラー"
          },
          "413": {
            "description": "ファイルサイズが 20 MB を超えているか、画素数が上限を超えています"
          },
          "500": {
            "description": "画像処理・マスク保存・ファイル保存のいずれかに失敗しました"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "ジョブ一覧を取得",
        "description": "最近のジョブを作成日時の降順で返します。",
        "operationId": "list_process_jobs_api_images_jobs_get",
        "responses": {
          "200": {
            "description": "ジョブの一覧（新しい順）",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/QueuedJobResponse"
                      },
                      {
                        "$ref": "#/components/schemas/RunningJobResponse"
                      },
                      {
                        "$ref": "#/components/schemas/CompletedJobResponse"
                      },
                      {
                        "$ref": "#/components/schemas/FailedJobResponse"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "status",
                      "mapping": {
                        "queued": "#/components/schemas/QueuedJobResponse",
                        "running": "#/components/schemas/RunningJobResponse",
                        "completed": "#/components/schemas/CompletedJobResponse",
                        "failed": "#/components/schemas/FailedJobResponse"
                      }
                    }
                  },
                  "type": "array",
                  "title": "Response List Process Jobs Api Images Jobs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "ジョブを作成",
        "description": "画像処理ジョブをキューに登録し、非同期で処理を開始します。\n\nジョブ ID を使って `GET /jobs/{job_id}` でステータスをポーリングしてください。",
        "operationId": "create_process_job_api_images_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_process_job_api_images_jobs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "作成されたジョブの初期状態（status: queued）",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QueuedJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RunningJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CompletedJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/FailedJobResponse"
                    }
                  ],
                  "title": "Response Create Process Job Api Images Jobs Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "queued": "#/components/schemas/QueuedJobResponse",
                      "running": "#/components/schemas/RunningJobResponse",
                      "completed": "#/components/schemas/CompletedJobResponse",
                      "failed": "#/components/schemas/FailedJobResponse"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ファイル名が不正、ファイルが空、画像として認識できない、または operations のバリデーションエラー"
          },
          "413": {
            "description": "ファイルサイズが 20 MB を超えているか、画素数が上限を超えています"
          },
          "503": {
            "description": "ジョブキューが満杯です。しばらく後に再試行してください"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "ジョブを取得",
        "description": "指定した `job_id` のジョブ詳細を返します。",
        "operationId": "get_process_job_api_images_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "指定ジョブの現在の状態",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QueuedJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RunningJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CompletedJobResponse"
                    },
                    {
                      "$ref": "#/components/schemas/FailedJobResponse"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "queued": "#/components/schemas/QueuedJobResponse",
                      "running": "#/components/schemas/RunningJobResponse",
                      "completed": "#/components/schemas/CompletedJobResponse",
                      "failed": "#/components/schemas/FailedJobResponse"
                    }
                  },
                  "title": "Response Get Process Job Api Images Jobs  Job Id  Get"
                }
              }
            }
          },
          "404": {
            "description": "指定されたジョブが見つかりません"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
